environments:
  default:
    values:
      - externalVault:
          server: "{{ env "EXTERNAL_VAULT_SERVER" }}"
          path: "{{ env "EXTERNAL_VAULT_PATH" | default "secret" }}"
          version: "v2"
          authPath: "{{ env "EXTERNAL_VAULT_AUTH_PATH" | default "kubernetes" }}"
      - ingressController:
          replicaCount: "{{ env "INGRESS_REPLICAS" | default 1 }}"
          cloudflared:
            replicaCount: "{{ env "CLOUDFLARED_REPLICAS" | default 1 }}"
            protocol: "{{ env "CLOUDFLARED_PROTOCOL" | default "auto" }}"
      - vaultSecretPaths:
          argocd: "gitops/dev/argocd"
          cloudflare: "gitops/dev/cloudflare"
          grafanaCloud: "gitops/dev/grafana-cloud"
---
helmfiles:
  - path: ../gitops-cluster-services/helmfile.yaml
    values:
      - clusterName: gitops-dev
      - ingressController:
          replicaCount: {{ .Values.ingressController.replicaCount }}
          cloudflared:
            replicaCount: {{ .Values.ingressController.cloudflared.replicaCount }}
            protocol: {{ .Values.ingressController.cloudflared.protocol }}
      - externalVault:
          server: {{ .Values.externalVault.server }}
          path: {{ .Values.externalVault.path }}
          version: {{ .Values.externalVault.version }}
          authPath: {{ .Values.externalVault.authPath }}
      - vaultSecretPaths: {{ .Values.vaultSecretPaths | toYaml | nindent 10 }}
