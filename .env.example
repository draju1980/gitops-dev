# Vault Configuration
# IMPORTANT: Only needed for first-time deployment (bootstrap phase)
# After bootstrap, ArgoCD manages vault credentials internally
export EXTERNAL_VAULT_SERVER="http://127.0.0.1:8200"
export VAULT_ADDR="http://127.0.0.1:8200"
export VAULT_TOKEN="hvs.your-token"

# Note: ArgoCD admin password hash is stored in Vault, not passed as env var
# Generate hash with: htpasswd -nbBC 10 "" "YourStrongPassword" | sed 's/^://'

# Vault Secret Paths and Authentication (Optional - defaults provided)
export EXTERNAL_VAULT_PATH="secret"
export EXTERNAL_VAULT_AUTH_PATH="kubernetes"
export EXTERNAL_VAULT_AUTH_ROLE="external-secrets"

# Ingress Controller Configuration (Optional - defaults provided)
export INGRESS_REPLICAS=1
export CLOUDFLARED_REPLICAS=1
export CLOUDFLARED_PROTOCOL="auto"
